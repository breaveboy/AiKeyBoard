/* Main Window Styling */
QWidget#MainWindowsForm {
    background-color: #ffffff; /* White background for the entire window */
    border-radius: 10px; /* Rounded corners for the entire window */
}

/* Top Bar Styling */
QWidget#widget {
    background-color: #ffffff; /* White background for the top bar */
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

/* Common Button Styling */
QPushButton {
    border: none;
    background-color: transparent;
    padding: 5px;
    border-radius: 5px;
}
QPushButton:checked {
    background-color: #c0c0c0; /* Darker grey when pressed */
}

/* Specific Button Styling (top, setting, close) */
QPushButton#top_btn, QPushButton#setting_btn, QPushButton#cloase_btn {
    icon-size: 20px 20px;
}

QPushButton#cloase_btn:hover {
    background-color: #ff6b6b; /* Reddish on hover for close button */
}

QPushButton#cloase_btn:pressed {
    background-color: #ff4757; /* Darker reddish when pressed */
}

/* QTextEdit Styling */
QTextEdit {
    border: 1px solid #dcdcdc; /* Lighter grey border */
    border-radius: 8px; /* Slightly more rounded corners */
    padding: 8px;
    background-color: #ffffff;
    font-size: 14px;
    color: #333333;
}

QTextEdit:focus {
    border: 2px solid #2196F3; /* Blue border when focused */
}

/* QLabel Styling */
QLabel {
    color: #333333;
    font-size: 14px;
}
